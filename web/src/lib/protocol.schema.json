{
  "$defs": {
    "AcpSpec": {
      "additionalProperties": false,
      "description": "An external ACP agent, such as `claude-agent-acp` or `opencode acp`.",
      "properties": {
        "aid_tools": {
          "default": true,
          "type": "boolean"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "inherit_env": {
          "default": true,
          "type": "boolean"
        },
        "kind": {
          "const": "acp",
          "default": "acp",
          "type": "string"
        },
        "mcp_servers": {
          "$ref": "#/$defs/McpServers"
        },
        "permission": {
          "$ref": "#/$defs/PermissionMode",
          "default": "deny"
        },
        "permission_timeout": {
          "default": 1800,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "worker_ca": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "worker_command": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "worker_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "cwd",
        "kind",
        "command"
      ],
      "title": "AcpSpec",
      "type": "object"
    },
    "AgentCatalog": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/AgentInfo"
          },
          "type": "array"
        },
        "problems": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "agents",
        "tools",
        "problems"
      ],
      "title": "AgentCatalog",
      "type": "object"
    },
    "AgentInfo": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "module"
      ],
      "title": "AgentInfo",
      "type": "object"
    },
    "AgentKind": {
      "enum": [
        "acp",
        "pydantic-ai",
        "claude-tty"
      ],
      "title": "AgentKind",
      "type": "string"
    },
    "AgentSpec": {
      "discriminator": {
        "mapping": {
          "acp": "#/$defs/AcpSpec",
          "claude-tty": "#/$defs/ClaudeTtySpec",
          "pydantic-ai": "#/$defs/PydanticAISpec"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AcpSpec"
        },
        {
          "$ref": "#/$defs/PydanticAISpec"
        },
        {
          "$ref": "#/$defs/ClaudeTtySpec"
        }
      ]
    },
    "AnswerPermission": {
      "additionalProperties": false,
      "description": "A person's answer to a pending PermissionRequest: one of its options, or None to cancel it.",
      "properties": {
        "id": {
          "type": "string"
        },
        "op": {
          "const": "answer_permission",
          "default": "answer_permission",
          "type": "string"
        },
        "option_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "plugin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "request_id": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "session",
        "request_id",
        "option_id"
      ],
      "title": "AnswerPermission",
      "type": "object"
    },
    "Cancel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "op": {
          "const": "cancel",
          "default": "cancel",
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "session"
      ],
      "title": "Cancel",
      "type": "object"
    },
    "ClaudeTtySpec": {
      "additionalProperties": false,
      "description": "Interactive Claude Code in a pymux window: prompts are pasted in, events come from its transcript.\n\nA person can attach to the window, and Remote Control works, which the Agent SDK behind ACP does not offer.",
      "properties": {
        "aid_tools": {
          "default": true,
          "type": "boolean"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "inherit_env": {
          "default": true,
          "type": "boolean"
        },
        "kind": {
          "const": "claude-tty",
          "default": "claude-tty",
          "type": "string"
        },
        "mcp_servers": {
          "$ref": "#/$defs/McpServers"
        },
        "pymux_command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "pymux_socket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trust_cwd": {
          "default": false,
          "type": "boolean"
        },
        "worker_ca": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "worker_command": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "worker_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "cwd",
        "kind"
      ],
      "title": "ClaudeTtySpec",
      "type": "object"
    },
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Cost",
      "type": "object"
    },
    "CreateSession": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "type": "string"
        },
        "op": {
          "const": "create",
          "default": "create",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/AgentSpec"
        }
      },
      "required": [
        "op",
        "name",
        "spec"
      ],
      "title": "CreateSession",
      "type": "object"
    },
    "DeleteSession": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "op": {
          "const": "delete",
          "default": "delete",
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "session"
      ],
      "title": "DeleteSession",
      "type": "object"
    },
    "Done": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "id": {
          "type": "string"
        },
        "reply": {
          "const": "done",
          "default": "done",
          "type": "string"
        }
      },
      "required": [
        "reply",
        "id",
        "data"
      ],
      "title": "Done",
      "type": "object"
    },
    "Entry": {
      "properties": {
        "dir": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "dir",
        "size"
      ],
      "title": "Entry",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/SessionEvent"
        },
        "id": {
          "type": "string"
        },
        "reply": {
          "const": "event",
          "default": "event",
          "type": "string"
        }
      },
      "required": [
        "reply",
        "id",
        "event"
      ],
      "title": "Event",
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "reply": {
          "const": "failure",
          "default": "failure",
          "type": "string"
        }
      },
      "required": [
        "reply",
        "id",
        "code",
        "message"
      ],
      "title": "Failure",
      "type": "object"
    },
    "FileActivity": {
      "additionalProperties": false,
      "properties": {
        "last_seq": {
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "reads": {
          "default": 0,
          "type": "integer"
        },
        "writes": {
          "default": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "reads",
        "writes",
        "last_seq"
      ],
      "title": "FileActivity",
      "type": "object"
    },
    "FileView": {
      "properties": {
        "highlights": {
          "anyOf": [
            {
              "items": {
                "items": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ],
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "path": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "size",
        "text",
        "truncated",
        "highlights"
      ],
      "title": "FileView",
      "type": "object"
    },
    "GetHistory": {
      "additionalProperties": false,
      "description": "A page of a session's history: the newest entries before `before`, the oldest after `after`, or the\nnewest of all when neither is given.",
      "properties": {
        "after": {
          "anyOf": [
            {
              "minimum": -1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "before": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "limit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "op": {
          "const": "history",
          "default": "history",
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "wait": {
          "default": 0,
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "op",
        "session"
      ],
      "title": "GetHistory",
      "type": "object"
    },
    "GetStatus": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "op": {
          "const": "status",
          "default": "status",
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "session"
      ],
      "title": "GetStatus",
      "type": "object"
    },
    "GetSummary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "op": {
          "const": "summary",
          "default": "summary",
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "session"
      ],
      "title": "GetSummary",
      "type": "object"
    },
    "HistoryEntry": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "number"
        },
        "item": {
          "$ref": "#/$defs/HistoryItem"
        },
        "seq": {
          "type": "integer"
        },
        "turn": {
          "type": "string"
        }
      },
      "required": [
        "seq",
        "at",
        "turn",
        "item"
      ],
      "title": "HistoryEntry",
      "type": "object"
    },
    "HistoryItem": {
      "discriminator": {
        "mapping": {
          "error": "#/$defs/TurnError",
          "lifecycle": "#/$defs/Lifecycle",
          "message": "#/$defs/MessageEntry",
          "output": "#/$defs/Output",
          "permission_decision": "#/$defs/PermissionDecision",
          "permission_request": "#/$defs/PermissionRequest",
          "prompt": "#/$defs/PromptEntry",
          "started": "#/$defs/Started",
          "text": "#/$defs/TextDelta",
          "thought": "#/$defs/ThoughtDelta",
          "tool_call": "#/$defs/ToolCall",
          "usage": "#/$defs/Usage"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PromptEntry"
        },
        {
          "$ref": "#/$defs/MessageEntry"
        },
        {
          "$ref": "#/$defs/Started"
        },
        {
          "$ref": "#/$defs/Lifecycle"
        },
        {
          "$ref": "#/$defs/TextDelta"
        },
        {
          "$ref": "#/$defs/ThoughtDelta"
        },
        {
          "$ref": "#/$defs/ToolCall"
        },
        {
          "$ref": "#/$defs/PermissionRequest"
        },
        {
          "$ref": "#/$defs/PermissionDecision"
        },
        {
          "$ref": "#/$defs/Usage"
        },
        {
          "$ref": "#/$defs/Output"
        },
        {
          "$ref": "#/$defs/TurnError"
        }
      ]
    },
    "HistoryPage": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/HistoryEntry"
          },
          "type": "array"
        },
        "has_newer": {
          "type": "boolean"
        },
        "has_older": {
          "type": "boolean"
        },
        "total": {
          "type": "integer"
        }
      },
      "required": [
        "entries",
        "has_older",
        "has_newer",
        "total"
      ],
      "title": "HistoryPage",
      "type": "object"
    },
    "JsonValue": {},
    "Lifecycle": {
      "additionalProperties": false,
      "description": "Something happened to the agent's session outside a turn: interactive Claude compacted its context,\ncleared it (a new agent session follows, with a Started), or ended.",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "event": {
          "enum": [
            "compacted",
            "cleared",
            "ended"
          ],
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "lifecycle",
          "default": "lifecycle",
          "type": "string"
        }
      },
      "required": [
        "type",
        "event",
        "detail",
        "summary"
      ],
      "title": "Lifecycle",
      "type": "object"
    },
    "ListAgents": {
      "additionalProperties": false,
      "description": "The `aid.PydanticAgent`s on the daemon's agents path.",
      "properties": {
        "id": {
          "type": "string"
        },
        "op": {
          "const": "agents",
          "default": "agents",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "title": "ListAgents",
      "type": "object"
    },
    "ListSessions": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "op": {
          "const": "list",
          "default": "list",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "title": "ListSessions",
      "type": "object"
    },
    "McpHttp": {
      "additionalProperties": false,
      "properties": {
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "pattern": "^[\\w-]+$",
          "type": "string"
        },
        "type": {
          "const": "http",
          "default": "http",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "url"
      ],
      "title": "McpHttp",
      "type": "object"
    },
    "McpServer": {
      "discriminator": {
        "mapping": {
          "http": "#/$defs/McpHttp",
          "sse": "#/$defs/McpSse",
          "stdio": "#/$defs/McpStdio"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/McpStdio"
        },
        {
          "$ref": "#/$defs/McpHttp"
        },
        {
          "$ref": "#/$defs/McpSse"
        }
      ]
    },
    "McpServers": {
      "items": {
        "$ref": "#/$defs/McpServer"
      },
      "type": "array"
    },
    "McpSse": {
      "additionalProperties": false,
      "properties": {
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "pattern": "^[\\w-]+$",
          "type": "string"
        },
        "type": {
          "const": "sse",
          "default": "sse",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "url"
      ],
      "title": "McpSse",
      "type": "object"
    },
    "McpStdio": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "pattern": "^[\\w-]+$",
          "type": "string"
        },
        "type": {
          "const": "stdio",
          "default": "stdio",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "command"
      ],
      "title": "McpStdio",
      "type": "object"
    },
    "MessageEntry": {
      "additionalProperties": false,
      "description": "A message another session, or a person, sent to this one.",
      "properties": {
        "sender": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "type": {
          "const": "message",
          "default": "message",
          "type": "string"
        }
      },
      "required": [
        "type",
        "sender",
        "text"
      ],
      "title": "MessageEntry",
      "type": "object"
    },
    "Output": {
      "additionalProperties": false,
      "description": "Final event of a prompt. `output` is text for ACP and the agent's typed output for pydantic-ai.",
      "properties": {
        "output": {
          "$ref": "#/$defs/JsonValue"
        },
        "stop_reason": {
          "type": "string"
        },
        "type": {
          "const": "output",
          "default": "output",
          "type": "string"
        }
      },
      "required": [
        "type",
        "output",
        "stop_reason"
      ],
      "title": "Output",
      "type": "object"
    },
    "PageReply": {
      "discriminator": {
        "mapping": {
          "done": "#/$defs/Done",
          "event": "#/$defs/Event",
          "failure": "#/$defs/Failure"
        },
        "propertyName": "reply"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Event"
        },
        {
          "$ref": "#/$defs/Done"
        },
        {
          "$ref": "#/$defs/Failure"
        }
      ]
    },
    "PageRequest": {
      "discriminator": {
        "mapping": {
          "agents": "#/$defs/ListAgents",
          "answer_permission": "#/$defs/AnswerPermission",
          "cancel": "#/$defs/Cancel",
          "create": "#/$defs/CreateSession",
          "delete": "#/$defs/DeleteSession",
          "history": "#/$defs/GetHistory",
